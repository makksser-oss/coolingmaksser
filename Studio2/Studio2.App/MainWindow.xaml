<Window x:Class="LovingCool.Studio2.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LOVINGCOOL Studio 2" Width="1600" Height="980" MinWidth="1280" MinHeight="760" WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
<Border Background="{StaticResource PanelBrush}" Padding="18"><StackPanel><TextBlock Text="◈  LOVINGCOOL" Foreground="White" FontSize="20" FontWeight="Bold"/><TextBlock Text="STUDIO 2" Foreground="#21D7FF" FontSize="13" Margin="28,0,0,28"/><Button Content="⌂   Главная" Height="44"/><Button Content="▦   Редактор экрана" Height="44" Margin="0,8,0,0"/><Button Content="◉   Мониторинг" Height="44" Margin="0,8,0,0"/><Button Content="▶   Медиа" Height="44" Margin="0,8,0,0"/><Button Content="▣   Зеркалирование" Height="44" Margin="0,8,0,0"/><Button Content="◎   Профили" Height="44" Margin="0,8,0,0"/><Button Content="⚙   Настройки" Height="44" Margin="0,8,0,0"/></StackPanel></Border>
<Border Grid.Column="1" Background="#0A1220" Padding="16"><StackPanel><TextBlock Text="Элементы" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/><UniformGrid Columns="2"><Button Content="T&#x0a;Текст" Height="70"/><Button Content="◷&#x0a;Часы"/><Button Content="◉&#x0a;Кольцо" Height="70"/><Button Content="▰&#x0a;Шкала"/><Button Content="⌁&#x0a;График" Height="70"/><Button Content="▧&#x0a;Изображение"/><Button Content="▶&#x0a;Видео / GIF" Height="70"/><Button Content="◈&#x0a;Датчик"/></UniformGrid></StackPanel></Border>
<Grid Grid.Column="2" Margin="22"><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="120"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Редактор экрана" Foreground="White" FontSize="25" FontWeight="Bold"/><TextBlock Text="480 × 480  •  холст всегда прямо  •  ориентация применяется только при выводе" Foreground="{StaticResource MutedBrush}"/></StackPanel><Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="24"><Viewbox Stretch="Uniform"><Border Width="520" Height="520" Background="#050A13" Padding="20"><Canvas Width="480" Height="480" Background="#081229"><TextBlock Text="LOVINGCOOL STUDIO 2" Foreground="#21D7FF" FontSize="18" Canvas.Left="132" Canvas.Top="222"/></Canvas></Border></Viewbox></Border><Border Grid.Row="2" Background="{StaticResource PanelBrush}" Margin="0,16,0,0" Padding="12"><StackPanel Orientation="Horizontal"><Button Content="NEON" Width="105"/><Button Content="SYSTEM" Width="105" Margin="10,0"/><Button Content="MINIMAL" Width="105"/><Button Content="CLOCK" Width="105" Margin="10,0"/><Button Content="GAMING" Width="105"/></StackPanel></Border></Grid>
<Border Grid.Column="3" Background="{StaticResource PanelBrush}" Padding="16"><TabControl><TabItem Header="Свойства"><StackPanel Margin="10"><TextBlock Text="Свойства элемента" Foreground="White" FontSize="17" FontWeight="Bold"/><TextBlock Text="Позиция и размер" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,6"/><UniformGrid Columns="2"><TextBox Text="X: 40" Margin="3"/><TextBox Text="Y: 40" Margin="3"/><TextBox Text="W: 180" Margin="3"/><TextBox Text="H: 180" Margin="3"/></UniformGrid><TextBlock Text="Данные • стиль • анимация будут доступны для выбранного элемента." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0"/></StackPanel></TabItem><TabItem Header="Слои"/></TabControl></Border></Grid></Window>