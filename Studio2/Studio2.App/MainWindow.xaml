<Window x:Class="LovingCool.Studio2.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LovingCool.Studio2.App" Title="LOVINGCOOL Studio 2" Width="1600" Height="960" MinWidth="1280" MinHeight="760" WindowStartupLocation="CenterScreen" Background="#080D17" KeyDown="OnKey">
<Window.Resources>
 <Style TargetType="Button"><Setter Property="Background" Value="#14213A"/><Setter Property="Foreground" Value="#F2F6FF"/><Setter Property="BorderBrush" Value="#26354F"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,4"/><Setter Property="Cursor" Value="Hand"/></Style>
 <Style TargetType="TextBox"><Setter Property="Background" Value="#111C30"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#26354F"/><Setter Property="Padding" Value="7"/></Style>
</Window.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
<Border Background="#0B1220" Padding="16"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="◈  LOVINGCOOL" Foreground="White" FontSize="19" FontWeight="Bold"/><TextBlock Text="STUDIO 2" Foreground="#21D7FF" Margin="27,0,0,25"/><Button Content="▦  Редактор экрана"/><Button Content="◉  Мониторинг"/><Button Content="▶  Медиа"/><Button Content="▣  Зеркалирование"/><Button Content="◎  Профили"/><Button Content="⚙  Настройки"/></StackPanel><StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><TextBlock x:Name="DeviceStatus" Text="● LOVINGCOOL 6PRO&#x0a;  отключено" Foreground="#8B9AB7" Margin="0,0,0,8"/><Button Content="Подключить дисплей" Background="#555BFF" Click="Connect_Click"/><Button Content="Сохранить проект" Click="Save_Click"/></StackPanel></DockPanel></Border>
<Border Grid.Column="1" Background="#0D1626" Padding="14"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Элементы" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/><ScrollViewer><StackPanel><UniformGrid Columns="2"><Button Content="T&#x0a;Текст" Click="AddText"/><Button Content="◷&#x0a;Часы" Click="AddClock"/><Button Content="◉&#x0a;Кольцо" Click="AddRing"/><Button Content="◔&#x0a;Gauge" Click="AddGauge"/><Button Content="▰&#x0a;Шкала" Click="AddBar"/><Button Content="⌁&#x0a;График" Click="AddGraph"/><Button Content="▧&#x0a;Изображение" Click="AddImage"/><Button Content="◈&#x0a;Датчик" Click="AddSensor"/></UniformGrid><TextBlock Text="Датчики" Foreground="White" FontWeight="Bold" Margin="0,20,0,8"/><ComboBox x:Name="SensorPicker" DisplayMemberPath="Name" Background="#14213A" Foreground="White"/><Button Content="+ Добавить выбранный датчик" Click="AddPickedSensor" Background="#555BFF"/></StackPanel></ScrollViewer></DockPanel></Border>
<Grid Grid.Column="2" Margin="20"><Grid.RowDefinitions><RowDefinition Height="65"/><RowDefinition Height="*"/><RowDefinition Height="105"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="Редактор экрана" Foreground="White" FontSize="24" FontWeight="Bold"/><TextBlock Text="480 × 480 • холст всегда прямо • Ctrl+Z / Ctrl+Y / Delete" Foreground="#8B9AB7"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="↶" Width="44" Click="Undo_Click"/><Button Content="↷" Width="44" Click="Redo_Click"/></StackPanel></DockPanel><Border Grid.Row="1" Background="#0D1626" CornerRadius="9" Padding="18"><local:EditorCanvas x:Name="Canvas"/></Border><Border Grid.Row="2" Background="#0D1626" Margin="0,14,0,0" Padding="10"><StackPanel Orientation="Horizontal"><Button Content="NEON" Width="100"/><Button Content="SYSTEM" Width="100"/><Button Content="MINIMAL" Width="100"/><Button Content="CLOCK" Width="100"/><Button Content="GAMING" Width="100"/></StackPanel></Border></Grid>
<Border Grid.Column="3" Background="#0B1220" Padding="12"><TabControl><TabItem Header="Свойства"><ScrollViewer><StackPanel Margin="10"><TextBlock Text="Свойства элемента" Foreground="White" FontSize="17" FontWeight="Bold"/><TextBlock Text="Название" Foreground="#8B9AB7" Margin="0,15,0,5"/><TextBox x:Name="NameBox"/><TextBlock Text="Текст / шаблон" Foreground="#8B9AB7" Margin="0,12,0,5"/><TextBox x:Name="TextBox"/><TextBlock Text="Позиция и размер" Foreground="#8B9AB7" Margin="0,12,0,5"/><UniformGrid Columns="2"><TextBox x:Name="XBox" Margin="2"/><TextBox x:Name="YBox" Margin="2"/><TextBox x:Name="WBox" Margin="2"/><TextBox x:Name="HBox" Margin="2"/></UniformGrid><Button Content="Применить" Background="#555BFF" Click="Apply_Click"/><Button Content="Удалить элемент" Click="Delete_Click"/><Separator Margin="0,14"/><TextBlock Text="Ориентация физического LCD" Foreground="#8B9AB7"/><ComboBox x:Name="RotationBox" SelectionChanged="RotationChanged"><ComboBoxItem Content="90° влево"/><ComboBoxItem Content="0°"/><ComboBoxItem Content="180°"/><ComboBoxItem Content="90° вправо"/></ComboBox></StackPanel></ScrollViewer></TabItem><TabItem Header="Слои"><ListBox x:Name="LayerList" DisplayMemberPath="Name" SelectionChanged="LayerChanged" Background="#0D1626" Foreground="White"/></TabItem></TabControl></Border>
</Grid></Window>